#!/usr/bin/env bash

rofi_input() {
    local prompt="$1"
    local show_list="${2:-false}"

    if [[ "$show_list" == true ]]; then
        rofi -dmenu -i -p "$prompt" \
            -theme-str 'window { height: 140px; }'
    else
        rofi -dmenu -i -p "$prompt" \
            -theme-str 'window { height: 50px; }' \
            -theme-str 'listview { enabled: false; }' \
            -theme-str 'mainbox { children: [ inputbar ]; }'
    fi
}

language=$(printf '%s\n' 'English (define)' 'Turkish (tdk)' |
    rofi_input 'Dictionary' true)

[[ -z "$language" ]] && exit 0

word=$(rofi_input 'Word')

[[ -z "$word" ]] && exit 0

case "$language" in
    'English (define)')
        "$HOME/.local/bin/define" "$word"
        ;;
    'Turkish (tdk)')
        "$HOME/.local/bin/tdk" "$word"
        ;;
esac
